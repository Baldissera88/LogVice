<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>LogVice</displayName>
  <description>Policy settings for the LogVice log viewer.</description>
  <resources>
    <stringTable>
      <string id="LogVice">LogVice</string>
      <string id="SUPPORTED_LogVice_1_5">LogVice 1.5.0 or later</string>
      <string id="DisableUpdateCheck">Turn off the update check</string>
      <string id="DisableUpdateCheck_Help">LogVice checks GitHub once a day for a newer version and shows an Update button when one is available. It sends nothing about the user or the logs.

If you enable this policy, LogVice does not check for updates, and users cannot turn the check on.

If you disable or do not configure this policy, users can turn the check on or off under Settings > Updates. It is on by default.</string>
    </stringTable>
  </resources>
</policyDefinitionResources>
